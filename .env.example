# Production: set NEXT_PUBLIC_SITE_URL=https://www.eppixlabsshop.com in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random bytes. Signs guest cart cookies and hashes abuse-limit keys.
CART_COOKIE_SECRET=
# Production SMTP and Google OAuth are configured in the Supabase dashboard.
# Server only. Resend sending key restricted to eppixlabsshop.com.
# Sends support, affiliate and newsletter-preference notices to hello@eppixlabsshop.com.
RESEND_API_KEY=
