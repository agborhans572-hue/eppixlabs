{
  "name": "eppixlabs-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "capture": "node scripts/capture.mjs",
    "import": "node --env-file=.env.local scripts/import.mjs",
    "import:canada": "node --env-file=.env.local scripts/import-canada.mjs",
    "verify:stores": "node --env-file=.env.local scripts/verify-stores.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:signup-otp": "node --env-file=.env.local scripts/verify-signup-otp.mjs",
    "verify:account": "node --env-file=.env.local scripts/verify-account.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.1.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "three": "^0.183.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
